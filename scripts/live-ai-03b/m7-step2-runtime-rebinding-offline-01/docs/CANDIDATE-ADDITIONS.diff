+  let res;
+  ALREADY_RAN = true; // claim the one-shot BEFORE the mutation attempt: a throw can never lead to a retry.
+  try { res = await deps.restrictedDbActivate({ claims: v.claims, executionId: v.claims.execution_id }); }
