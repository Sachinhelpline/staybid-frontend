+  gatewayPubFp: "a".repeat(64), brokerPubFp: "a".repeat(64), reasoningModel: "gpt-5.6-terra", providerCredentialPresent: true,
+  gatesBeforeArm: { staging_text_enabled: false, staging_broker_enabled: false },
